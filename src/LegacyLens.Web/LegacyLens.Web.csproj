<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-LegacyLens_Web-0bfc2bda-b920-414f-a4a8-c1f9621ac733</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Los .resx neutros contienen el espanol, asi que es-ES no necesita
         ensamblado satelite y es el idioma al que se cae por omision. -->
    <NeutralResourcesLanguage>es-ES</NeutralResourcesLanguage>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Data\app.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!--
      El script de ejemplo viaja con el despliegue para que la demo pueda
      ejecutarse sin subir ningún fichero, también en el contenedor.
    -->
    <!-- Glob y no una entrada por fichero: añadir un ejemplo no debe obligar a
         tocar el csproj, que es justo el tipo de paso que se olvida. -->
    <!-- El logo vive una sola vez en assets/ y se enlaza a wwwroot. Copiarlo
         sería la cuarta copia del mismo dibujo en el repositorio. -->
    <Content Include="..\..\assets\logo*.svg" Link="wwwroot\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\samples\*.sql" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LegacyLens.Domain\LegacyLens.Domain.csproj" />
    <ProjectReference Include="..\LegacyLens.Analysis\LegacyLens.Analysis.csproj" />
    <ProjectReference Include="..\LegacyLens.Ai\LegacyLens.Ai.csproj" />
    <ProjectReference Include="..\LegacyLens.Application\LegacyLens.Application.csproj" />
    <ProjectReference Include="..\LegacyLens.Persistence.EF\LegacyLens.Persistence.EF.csproj" />
  </ItemGroup>

</Project>
