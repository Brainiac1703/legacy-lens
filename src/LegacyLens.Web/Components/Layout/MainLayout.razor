@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @*
            La barra superior traía un enlace «About» a la documentación de
            ASP.NET Core, resto de la plantilla. No tenía nada que ver con este
            producto, así que se va con el selector de idioma que ocupa su sitio.
        *@
        <div class="top-row px-4">
            <CultureSelector />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
