@if (!string.IsNullOrEmpty(TextoVisible))
{
    <div class="alert alert-@(EsError ? "danger" : "success")" role="alert">
        @TextoVisible
    </div>
}

@code {
    private string? mensajeDeCookie;
    private bool errorDeCookie;

    [Parameter]
    public string? Message { get; set; }

    /// <summary>
    /// Severidad del mensaje pasado por parámetro. La plantilla la deducía
    /// comprobando si el texto empezaba por «Error», y eso deja de funcionar en
    /// cuanto se traduce: «El correo o la contraseña no son correctos» no empieza
    /// por Error, así que un fallo se pintaba en verde.
    /// </summary>
    [Parameter]
    public bool IsError { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? TextoVisible => Message ?? mensajeDeCookie;

    private bool EsError => Message is not null
        ? IsError
        : errorDeCookie;

    protected override void OnInitialized()
    {
        var crudo = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (crudo is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);

            // La cookie lleva la severidad en la primera letra: E de error, S de
            // correcto. Las páginas que aún no se han localizado siguen pasando
            // mensajes que empiezan por «Error», así que se mantiene esa lectura
            // como respaldo en lugar de romperlas.
            if (crudo.Length > 0 && (crudo[0] == 'E' || crudo[0] == 'S'))
            {
                errorDeCookie = crudo[0] == 'E';
                mensajeDeCookie = crudo[1..];
            }
            else
            {
                errorDeCookie = crudo.StartsWith("Error", StringComparison.Ordinal);
                mensajeDeCookie = crudo;
            }
        }
    }
}
