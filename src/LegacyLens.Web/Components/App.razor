<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["LegacyLens.Web.styles.css"]" />
    <ImportMap />
    <!-- El SVG escala y es el que usarán los navegadores actuales; el png de
         la plantilla se queda como reserva para los que no lo admiten. -->
    <link rel="icon" type="image/svg+xml" href="logo.svg" />
    <link rel="alternate icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>

    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
    <script>
        // El grafo se dibuja bajo demanda desde el componente, no al cargar.
        if (typeof mermaid !== 'undefined') {
            mermaid.initialize({ startOnLoad: false, securityLevel: 'strict' });
        }
    </script>
    <script src="@Assets["js/legacy-lens.js"]"></script>
</body>

</html>
