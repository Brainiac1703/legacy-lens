@page "/"

@inject IStringLocalizer<UiText> L

<PageTitle>Legacy Lens</PageTitle>

<h1>Legacy Lens</h1>

<p class="lead">@L["Home_Lead"]</p>

<p>@L["Home_Problem"]</p>

<p>@L["Home_WhatItDoes"]</p>

<div class="card border-primary mb-4">
    <div class="card-header bg-primary text-white">@L["Home_IdeaTitle"]</div>
    <div class="card-body">
        <p class="mb-2"><strong>@L["Home_IdeaClaim"]</strong></p>
        <p class="mb-0">@L["Home_IdeaBody"]</p>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">@L["Home_Step1Title"]</h5>
                <p class="card-text small">@L["Home_Step1Body"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">@L["Home_Step2Title"]</h5>
                <p class="card-text small">@L["Home_Step2Body"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">@L["Home_Step3Title"]</h5>
                <p class="card-text small">@L["Home_Step3Body"]</p>
            </div>
        </div>
    </div>
</div>

<AuthorizeView>
    <Authorized>
        <p class="mt-4">
            <a class="btn btn-primary" href="/analyze">@L["Home_CtaAnalyze"]</a>
        </p>
    </Authorized>
    <NotAuthorized>
        <p class="mt-4">
            <a class="btn btn-primary" href="Account/Login">@L["Home_CtaSignIn"]</a>
        </p>
    </NotAuthorized>
</AuthorizeView>
