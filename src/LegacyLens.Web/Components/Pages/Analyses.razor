@page "/analyses"
@using System.Security.Claims
@using LegacyLens.Application.Abstractions
@using LegacyLens.Application.Analyses
@using MediatR
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

@inject ISender Sender
@inject IStringLocalizer<UiText> L

<PageTitle>@L["Analyses_Title"] | Legacy Lens</PageTitle>

<h1>@L["Analyses_Title"]</h1>

@if (analyses is null)
{
    <p class="text-secondary">@L["Analyses_Loading"]</p>
}
else if (analyses.Count == 0)
{
    <p class="text-secondary">
        @L["Analyses_EmptyBefore"]
        <a href="/analyze">@L["Analyses_EmptyLink"]</a>.
    </p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>@L["Analyses_ColFile"]</th>
                <th>@L["Analyses_ColDate"]</th>
                <th class="text-end">@L["Analyses_ColObjects"]</th>
                <th>@L["Analyses_ColContent"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in analyses)
            {
                <tr>
                    <td><code>@item.FileName</code></td>
                    @* La cultura actual decide el formato: no se fija uno a mano. *@
                    <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-end">@item.ObjectCount</td>
                    <td>
                        @if (item.HasAiDocumentation)
                        {
                            <span class="badge text-bg-success">@L["Analyses_BadgeDocumented"]</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">@L["Analyses_BadgeStaticOnly"]</span>
                        }
                        @if (item.HasPlan)
                        {
                            <span class="badge text-bg-primary">@L["Analyses_BadgeWithPlan"]</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" href="/analyses/@item.Id">@L["Analyses_View"]</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // AnalysisSummary es un modelo de lectura de la capa de aplicación, no la
    // entidad de persistencia: la página ya no sabe cómo se guardan los datos.
    private IReadOnlyList<AnalysisSummary>? analyses;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        string? userId = null;

        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }

        analyses = await Sender.Send(new ListAnalysesQuery(userId ?? string.Empty));
    }
}
