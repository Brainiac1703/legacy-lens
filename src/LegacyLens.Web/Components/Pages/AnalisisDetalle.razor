@page "/analisis/{Id:guid}"
@using System.Security.Claims
@using LegacyLens.Domain
@using LegacyLens.Web.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

@inject AnalysisStore Store
@inject CostEstimator Costs
@inject IJSRuntime JS

<PageTitle>@(result?.SourceFileName ?? "Análisis") | Legacy Lens</PageTitle>

@if (loading)
{
    <p class="text-secondary">Cargando el análisis...</p>
}
else if (result is null)
{
    <div class="alert alert-warning">Este análisis no existe o no es tuyo.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1 class="mb-1">@result.SourceFileName</h1>
            <p class="text-secondary mb-0">
                Analizado el @result.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
        <a class="btn btn-outline-primary" href="/analisis/@Id/markdown" target="_blank">
            Descargar documentación
        </a>
    </div>

    <hr />

    <div class="row g-3 mb-4">
        @foreach (var (label, value) in SummaryTiles())
        {
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    <div class="card-body py-3">
                        <div class="fs-3 fw-semibold">@value</div>
                        <div class="small text-secondary">@label</div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (result.Usage.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-body py-3">
                <h6 class="card-title mb-3">Consumo de este análisis</h6>

                <table class="table table-sm mb-2">
                    <thead>
                        <tr>
                            <th>Modelo</th>
                            <th class="text-end">Llamadas</th>
                            <th class="text-end">Tokens entrada</th>
                            <th class="text-end">Tokens salida</th>
                            <th class="text-end">Coste estimado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Costs.Breakdown(result))
                        {
                            <tr>
                                <td><code>@line.Usage.Model</code></td>
                                <td class="text-end">@line.Usage.Calls</td>
                                <td class="text-end">@line.Usage.InputTokens.ToString("N0")</td>
                                <td class="text-end">@line.Usage.OutputTokens.ToString("N0")</td>
                                <td class="text-end">
                                    @(line.EstimatedUsd is { } usd
                                        ? CostEstimator.Format(usd)
                                        : "sin precio configurado")
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (Costs.TotalUsd(result) is { } total)
                    {
                        <tfoot>
                            <tr class="fw-semibold">
                                <td colspan="4" class="text-end">Total estimado</td>
                                <td class="text-end">@CostEstimator.Format(total)</td>
                            </tr>
                        </tfoot>
                    }
                </table>

                <p class="small text-secondary mb-0">
                    El coste es una estimación calculada a partir de los tokens consumidos y los
                    precios configurados. Los tokens son reales; los precios, orientativos.
                </p>
            </div>
        </div>
    }

    @if (result.ParseErrors.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>El script contiene @result.ParseErrors.Count error(es) de sintaxis.</strong>
            Los objetos afectados no se han podido analizar.
            <ul class="mb-0 mt-2 small">
                @foreach (var parseError in result.ParseErrors.Take(10))
                {
                    <li>@parseError</li>
                }
            </ul>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in Tabs)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == tab ? "active" : "")"
                        @onclick="() => SetTab(tab)">
                    @tab
                </button>
            </li>
        }
    </ul>

    @if (activeTab == "Plan")
    {
        @if (result.Plan is null)
        {
            <div class="alert alert-secondary">
                No se generó plan de migración. Ocurre cuando Azure OpenAI no está configurado
                o cuando la llamada falló; el análisis estático de las otras pestañas sigue
                siendo válido.
            </div>
        }
        else
        {
            <p class="lead">@result.Plan.Overview</p>

            @foreach (var phase in result.Plan.Phases.OrderBy(p => p.Order))
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>Fase @phase.Order — @phase.Title</strong>
                    </div>
                    <div class="card-body">
                        <p class="mb-2"><em>Por qué ahora:</em> @phase.Rationale</p>

                        @if (phase.Objects.Count > 0)
                        {
                            <p class="mb-2">
                                @foreach (var obj in phase.Objects)
                                {
                                    <code class="me-2">@obj</code>
                                }
                            </p>
                        }

                        <p class="mb-0 text-danger-emphasis"><em>Riesgo:</em> @phase.Risk</p>
                    </div>
                </div>
            }

            @if (result.Plan.GlobalRisks.Count > 0)
            {
                <h5>Riesgos del proyecto</h5>
                <ul>
                    @foreach (var risk in result.Plan.GlobalRisks)
                    {
                        <li>@risk</li>
                    }
                </ul>
            }

            <p class="small text-secondary">Plan generado con @result.Plan.ModelUsed.</p>
        }
    }
    else if (activeTab == "Objetos")
    {
        <div class="accordion" id="objetos">
            @foreach (var obj in Programmable)
            {
                var slug = obj.FullName.Replace('.', '-');

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button"
                                data-bs-toggle="collapse" data-bs-target="#c-@slug">
                            <span class="badge @BadgeClass(obj.Risk.Level) me-2">@obj.Risk.Value</span>
                            <code class="me-2">@obj.FullName</code>
                            <span class="text-secondary small">@obj.Kind</span>
                        </button>
                    </h2>
                    <div id="c-@slug" class="accordion-collapse collapse" data-bs-parent="#objetos">
                        <div class="accordion-body">
                            @if (obj.Documentation is { } doc)
                            {
                                <p>@doc.Summary</p>

                                @if (doc.BusinessRules.Count > 0)
                                {
                                    <h6>Reglas de negocio</h6>
                                    <ul>
                                        @foreach (var rule in doc.BusinessRules)
                                        {
                                            <li>@rule</li>
                                        }
                                    </ul>
                                }

                                @if (doc.SideEffects.Count > 0)
                                {
                                    <h6>Efectos colaterales</h6>
                                    <ul>
                                        @foreach (var effect in doc.SideEffects)
                                        {
                                            <li>@effect</li>
                                        }
                                    </ul>
                                }

                                <h6>Destino propuesto en .NET</h6>
                                <p>@doc.MigrationTarget</p>
                                <p class="small text-secondary">Interpretado con @doc.ModelUsed.</p>
                            }
                            else
                            {
                                <p class="text-secondary"><em>Sin documentación generada.</em></p>
                            }

                            <h6>Hechos verificados por el parser</h6>
                            <p class="small mb-2">
                                @obj.Metrics.Lines líneas ·
                                @obj.Metrics.StatementCount sentencias ·
                                complejidad @obj.Metrics.ControlFlowComplexity ·
                                @obj.Metrics.CursorCount cursor(es) ·
                                @obj.Metrics.DynamicSqlCount SQL dinámico ·
                                @obj.Metrics.TransactionCount transacción(es) ·
                                TRY/CATCH @(obj.Metrics.HasErrorHandling ? "sí" : "no")
                            </p>

                            @RenderEdges(obj, DependencyKind.Reads, "Lee")
                            @RenderEdges(obj, DependencyKind.Writes, "Escribe en")
                            @RenderEdges(obj, DependencyKind.Calls, "Invoca")

                            @if (obj.Risk.Factors.Count > 0)
                            {
                                <h6 class="mt-3">De dónde sale la puntuación @obj.Risk.Value</h6>
                                <ul class="small">
                                    @foreach (var factor in obj.Risk.Factors)
                                    {
                                        <li><strong>+@factor.Points</strong> @factor.Description</li>
                                    }
                                </ul>
                            }

                            <details class="mt-3">
                                <summary class="small">Ver el código original</summary>
                                <pre class="mt-2 p-2 bg-body-secondary small"><code>@obj.Body</code></pre>
                            </details>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (activeTab == "Grafo")
    {
        <div class="btn-group mb-3">
            <button class="btn btn-sm @(graphMode == GraphMode.Calls ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SetGraph(GraphMode.Calls)">
                Llamadas entre objetos
            </button>
            <button class="btn btn-sm @(graphMode == GraphMode.Data ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SetGraph(GraphMode.Data)">
                Flujo de datos
            </button>
        </div>

        <div class="card">
            <div class="card-body overflow-auto">
                <div id="mermaid-host"></div>
            </div>
        </div>

        <p class="small text-secondary mt-2">
            El color indica el riesgo calculado. Las aristas salen del árbol sintáctico del SQL,
            no de una inferencia del modelo.
        </p>
    }
}

@code {
    private enum GraphMode { Calls, Data }

    private static readonly string[] Tabs = ["Plan", "Objetos", "Grafo"];

    [Parameter] public Guid Id { get; set; }

    private AnalysisResult? result;
    private bool loading = true;
    private string activeTab = "Plan";
    private GraphMode graphMode = GraphMode.Calls;
    private bool graphNeedsRender;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private IEnumerable<SqlObject> Programmable =>
        result!.Objects.Where(o => o.IsProgrammable).OrderByDescending(o => o.Risk.Value);

    protected override async Task OnInitializedAsync()
    {
        string? userId = null;

        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }

        result = await Store.GetAsync(Id, userId);
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!graphNeedsRender || result is null) return;

        graphNeedsRender = false;

        var definition = graphMode == GraphMode.Calls
            ? MermaidGraphBuilder.BuildCallGraph(result)
            : MermaidGraphBuilder.BuildDataGraph(result);

        await JS.InvokeVoidAsync("legacyLens.renderMermaid", "mermaid-host", definition);
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        if (tab == "Grafo") graphNeedsRender = true;
    }

    private void SetGraph(GraphMode mode)
    {
        graphMode = mode;
        graphNeedsRender = true;
    }

    private IEnumerable<(string Label, string Value)> SummaryTiles()
    {
        var programmable = result!.Objects.Where(o => o.IsProgrammable).ToList();
        var risky = programmable.Count(o => o.Risk.Level is RiskLevel.High or RiskLevel.Critical);

        yield return ("Objetos analizados", result.ObjectCount.ToString());
        yield return ("Objetos programables", programmable.Count.ToString());
        yield return ("Dependencias detectadas", result.Dependencies.Count.ToString());
        yield return ("Riesgo alto o crítico", $"{risky} de {programmable.Count}");
    }

    private RenderFragment RenderEdges(SqlObject obj, DependencyKind kind, string label) => builder =>
    {
        var targets = result!.Dependencies
            .Where(d => d.From == obj.FullName && d.Kind == kind)
            .Select(d => d.To)
            .ToList();

        if (targets.Count == 0) return;

        builder.AddMarkupContent(0,
            $"<p class=\"small mb-1\"><strong>{label}:</strong> " +
            string.Join(", ", targets.Select(t => $"<code>{t}</code>")) +
            "</p>");
    };

    private static string BadgeClass(RiskLevel level) => level switch
    {
        RiskLevel.Low => "text-bg-success",
        RiskLevel.Medium => "text-bg-warning",
        RiskLevel.High => "text-bg-danger",
        _ => "text-bg-dark"
    };
}
