@page "/analizar"
@using System.Security.Claims
@using LegacyLens.Application.Abstractions
@using LegacyLens.Application.Analyses
@using LegacyLens.Application.Common
@using MediatR
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

@inject ISender Sender
@inject IAiEnrichmentService Ai
@inject NavigationManager Navigation
@inject ILogger<Analizar> Logger

<PageTitle>Analizar script | Legacy Lens</PageTitle>

<h1>Analizar un script T-SQL</h1>

<p class="text-secondary">
    Sube el script generado con <em>Generate Scripts</em> de SSMS. Legacy Lens extrae el
    inventario de objetos y el grafo de dependencias con el parser oficial de T-SQL, y
    después genera la documentación y el plan de migración con IA.
</p>

@if (!Ai.IsAvailable)
{
    <div class="alert alert-warning">
        <strong>Azure OpenAI no está configurado.</strong>
        El análisis estático funcionará con normalidad (inventario, dependencias, métricas y
        riesgo), pero no se generará documentación ni plan de migración.
    </div>
}

@if (estado is null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Subir un fichero</h5>

            <InputFile OnChange="OnFileSelected" class="form-control" accept=".sql,.txt" />

            <div class="form-text">Ficheros .sql de hasta @(MaxFileSizeMb) MB.</div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">O probar con el script de ejemplo</h5>
            <p class="card-text text-secondary">
                Una base de datos de ERP sintética que reproduce los patrones habituales de un
                sistema heredado: cursores, SQL dinámico, escrituras sin transacción y
                procedimientos encadenados.
            </p>
            <button class="btn btn-outline-primary" @onclick="RunSampleAsync" disabled="@ejecutando">
                Analizar el ejemplo
            </button>
        </div>
    </div>
}

@if (estado is not null)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@ficheroEnCurso</h5>
            <p class="mb-2">@estado.Message</p>

            @if (estado.Total > 0)
            {
                <div class="progress mb-2" role="progressbar" aria-valuenow="@estado.Percentage"
                     aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @(estado.Percentage)%">
                        @estado.Completed / @estado.Total
                    </div>
                </div>
            }
            else if (estado.Phase != AnalysisPhase.Done)
            {
                <div class="progress mb-2">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         style="width: 100%"></div>
                </div>
            }

            <ul class="list-unstyled small text-secondary mb-0">
                <li>@Marca(AnalysisPhase.Parsing) Análisis estático del script</li>
                <li>@Marca(AnalysisPhase.Documenting) Documentación de cada objeto</li>
                <li>@Marca(AnalysisPhase.Planning) Plan de migración</li>
                <li>@Marca(AnalysisPhase.Saving) Guardado</li>
            </ul>
        </div>
    </div>
}

@if (errores.Count > 0)
{
    <div class="alert alert-danger mt-3">
        <strong>No se pudo completar el análisis.</strong>
        <ul class="small mt-1 mb-2">
            @foreach (var error in errores)
            {
                <li>@error</li>
            }
        </ul>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Reiniciar">Volver a intentarlo</button>
    </div>
}

@code {
    private const int MaxFileSizeMb = 8;
    private const long MaxFileSize = MaxFileSizeMb * 1024L * 1024L;

    private AnalysisProgress? estado;
    private readonly List<string> errores = [];
    private bool ejecutando;
    private string ficheroEnCurso = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file.Size > MaxFileSize)
        {
            errores.Add($"El fichero pesa {file.Size / 1024 / 1024} MB y el límite son {MaxFileSizeMb} MB.");
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(MaxFileSize);
            using var reader = new StreamReader(stream);
            var script = await reader.ReadToEndAsync();

            await EjecutarAsync(script, file.Name);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error leyendo el fichero subido");
            errores.Add("No se pudo leer el fichero.");
        }
    }

    private async Task RunSampleAsync()
    {
        var path = Path.Combine(AppContext.BaseDirectory, "Samples", "legacy-erp.sql");

        if (!File.Exists(path))
        {
            errores.Add("No se encontró el script de ejemplo en el despliegue.");
            return;
        }

        await EjecutarAsync(await File.ReadAllTextAsync(path), "legacy-erp.sql");
    }

    /// <summary>
    /// Consume el flujo del caso de uso.
    ///
    /// El componente ya no orquesta nada: manda una petición y recorre lo que
    /// emite. Toda la coordinación entre parser, IA y persistencia vive en el
    /// handler, que es donde se puede probar sin un navegador delante.
    /// </summary>
    private async Task EjecutarAsync(string script, string fileName)
    {
        if (ejecutando) return;

        ejecutando = true;
        errores.Clear();
        ficheroEnCurso = fileName;

        try
        {
            var userId = await UsuarioActualAsync();
            var peticion = new AnalyzeScriptRequest(script, fileName, userId ?? string.Empty);

            await foreach (var paso in Sender.CreateStream(peticion))
            {
                estado = paso;
                StateHasChanged();

                if (paso.Phase == AnalysisPhase.Done && paso.AnalysisId is { } id)
                    Navigation.NavigateTo($"/analisis/{id}");
            }
        }
        catch (ValidationException ex)
        {
            // Los mensajes vienen del validador, así que se pueden mostrar tal cual.
            errores.AddRange(ex.Errors.SelectMany(e => e.Value));
            estado = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falló el análisis de {Fichero}", fileName);
            errores.Add(ex.Message);
            estado = null;
        }
        finally
        {
            ejecutando = false;
        }
    }

    private void Reiniciar()
    {
        errores.Clear();
        estado = null;
    }

    private async Task<string?> UsuarioActualAsync()
    {
        if (AuthenticationState is null) return null;

        var authState = await AuthenticationState;
        return authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    private string Marca(AnalysisPhase phase)
    {
        if (estado is null) return "○";
        if (estado.Phase > phase || estado.Phase == AnalysisPhase.Done) return "✓";
        return estado.Phase == phase ? "▸" : "○";
    }
}
