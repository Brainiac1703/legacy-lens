@page "/analyze"
@using System.Security.Claims
@using LegacyLens.Application.Abstractions
@using LegacyLens.Application.Analyses
@using LegacyLens.Application.Common
@using MediatR
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

@inject ISender Sender
@inject IAiEnrichmentService Ai
@inject NavigationManager Navigation
@inject ILogger<Analyze> Logger

<PageTitle>Analizar script | Legacy Lens</PageTitle>

<h1>Analizar un script T-SQL</h1>

<p class="text-secondary">
    Sube el script generado con <em>Generate Scripts</em> de SSMS. Legacy Lens extrae el
    inventario de objetos y el grafo de dependencias con el parser oficial de T-SQL, y
    después genera la documentación y el plan de migración con IA.
</p>

@if (!Ai.IsAvailable)
{
    <div class="alert alert-warning">
        <strong>Azure OpenAI no está configurado.</strong>
        El análisis estático funcionará con normalidad (inventario, dependencias, métricas y
        riesgo), pero no se generará documentación ni plan de migración.
    </div>
}

@if (state is null)
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Subir un fichero</h5>

            <InputFile OnChange="OnFileSelected" class="form-control" accept=".sql,.txt" />

            <div class="form-text">Ficheros .sql de hasta @(MaxFileSizeMb) MB.</div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5 class="card-title">O probar con el script de ejemplo</h5>
            <p class="card-text text-secondary">
                Una base de datos de ERP sintética que reproduce los patrones habituales de un
                sistema heredado: cursores, SQL dinámico, escrituras sin transacción y
                procedimientos encadenados.
            </p>
            <button class="btn btn-outline-primary" @onclick="RunSampleAsync" disabled="@running">
                Analizar el ejemplo
            </button>
        </div>
    </div>
}

@if (state is not null)
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">@currentFileName</h5>
            <p class="mb-2">@state.Message</p>

            @if (state.Total > 0)
            {
                <div class="progress mb-2" role="progressbar" aria-valuenow="@state.Percentage"
                     aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar" style="width: @(state.Percentage)%">
                        @state.Completed / @state.Total
                    </div>
                </div>
            }
            else if (state.Phase != AnalysisPhase.Done)
            {
                <div class="progress mb-2">
                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                         style="width: 100%"></div>
                </div>
            }

            <ul class="list-unstyled small text-secondary mb-0">
                <li>@Marker(AnalysisPhase.Parsing) Análisis estático del script</li>
                <li>@Marker(AnalysisPhase.Documenting) Documentación de cada objeto</li>
                <li>@Marker(AnalysisPhase.Planning) Plan de migración</li>
                <li>@Marker(AnalysisPhase.Saving) Guardado</li>
            </ul>
        </div>
    </div>
}

@if (errors.Count > 0)
{
    <div class="alert alert-danger mt-3">
        <strong>No se pudo completar el análisis.</strong>
        <ul class="small mt-1 mb-2">
            @foreach (var error in errors)
            {
                <li>@error</li>
            }
        </ul>
        <button class="btn btn-sm btn-outline-secondary" @onclick="Reset">Volver a intentarlo</button>
    </div>
}

@code {
    private const int MaxFileSizeMb = 8;
    private const long MaxFileSize = MaxFileSizeMb * 1024L * 1024L;

    private AnalysisProgress? state;
    private readonly List<string> errors = [];
    private bool running;
    private string currentFileName = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file.Size > MaxFileSize)
        {
            errors.Add($"El fichero pesa {file.Size / 1024 / 1024} MB y el límite son {MaxFileSizeMb} MB.");
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(MaxFileSize);
            using var reader = new StreamReader(stream);
            var script = await reader.ReadToEndAsync();

            await RunAnalysisAsync(script, file.Name);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error leyendo el fichero subido");
            errors.Add("No se pudo leer el fichero.");
        }
    }

    private async Task RunSampleAsync()
    {
        var path = Path.Combine(AppContext.BaseDirectory, "Samples", "legacy-erp.sql");

        if (!File.Exists(path))
        {
            errors.Add("No se encontró el script de ejemplo en el despliegue.");
            return;
        }

        await RunAnalysisAsync(await File.ReadAllTextAsync(path), "legacy-erp.sql");
    }

    /// <summary>
    /// Consume el flujo del caso de uso.
    ///
    /// El componente ya no orquesta nada: manda una petición y recorre lo que
    /// emite. Toda la coordinación entre parser, IA y persistencia vive en el
    /// handler, que es donde se puede probar sin un navegador delante.
    /// </summary>
    private async Task RunAnalysisAsync(string script, string fileName)
    {
        if (running) return;

        running = true;
        errors.Clear();
        currentFileName = fileName;

        try
        {
            var userId = await CurrentUserIdAsync();
            var request = new AnalyzeScriptRequest(script, fileName, userId ?? string.Empty);

            await foreach (var step in Sender.CreateStream(request))
            {
                state = step;
                StateHasChanged();

                if (step.Phase == AnalysisPhase.Done && step.AnalysisId is { } id)
                    Navigation.NavigateTo($"/analyses/{id}");
            }
        }
        catch (ValidationException ex)
        {
            // Los mensajes vienen del validador, así que se pueden mostrar tal cual.
            errors.AddRange(ex.Errors.SelectMany(e => e.Value));
            state = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falló el análisis de {Fichero}", fileName);
            errors.Add(ex.Message);
            state = null;
        }
        finally
        {
            running = false;
        }
    }

    private void Reset()
    {
        errors.Clear();
        state = null;
    }

    private async Task<string?> CurrentUserIdAsync()
    {
        if (AuthenticationState is null) return null;

        var authState = await AuthenticationState;
        return authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
    }

    private string Marker(AnalysisPhase phase)
    {
        if (state is null) return "○";
        if (state.Phase > phase || state.Phase == AnalysisPhase.Done) return "✓";
        return state.Phase == phase ? "▸" : "○";
    }
}
