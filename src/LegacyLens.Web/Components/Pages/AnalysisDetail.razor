@page "/analyses/{Id:guid}"
@using System.Security.Claims
@using LegacyLens.Application.Analyses
@using LegacyLens.Application.Costing
@using LegacyLens.Application.Documentation
@using LegacyLens.Domain
@using MediatR
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer

@inject ISender Sender
@inject CostEstimator Costs
@inject IStringLocalizer<UiText> L
@inject IJSRuntime JS

<PageTitle>@(result?.SourceFileName ?? L["Analyses_Title"].Value) | Legacy Lens</PageTitle>

@if (loading)
{
    <p class="text-secondary">@L["Detail_Loading"]</p>
}
else if (result is null)
{
    <div class="alert alert-warning">@L["Detail_NotFound"]</div>
}
else
{
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h1 class="mb-1">@result.SourceFileName</h1>
            <p class="text-secondary mb-0">
                @L["Detail_AnalyzedOn", result.CreatedAt.ToLocalTime().ToString("g")]
            </p>
        </div>
        <a class="btn btn-outline-primary" href="/analyses/@Id/markdown" target="_blank">
            @L["Detail_Download"]
        </a>
    </div>

    <hr />

    <div class="row g-3 mb-4">
        @foreach (var (label, value) in SummaryTiles())
        {
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    <div class="card-body py-3">
                        <div class="fs-3 fw-semibold">@value</div>
                        <div class="small text-secondary">@label</div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (result.Usage.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-body py-3">
                <h6 class="card-title mb-3">@L["Detail_UsageTitle"]</h6>

                <table class="table table-sm mb-2">
                    <thead>
                        <tr>
                            <th>@L["Detail_UsageModel"]</th>
                            <th class="text-end">@L["Detail_UsageCalls"]</th>
                            <th class="text-end">@L["Detail_UsageInput"]</th>
                            <th class="text-end">@L["Detail_UsageOutput"]</th>
                            <th class="text-end">@L["Detail_UsageCost"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Costs.Breakdown(result))
                        {
                            <tr>
                                <td><code>@line.Usage.Model</code></td>
                                <td class="text-end">@line.Usage.Calls</td>
                                <td class="text-end">@line.Usage.InputTokens.ToString("N0")</td>
                                <td class="text-end">@line.Usage.OutputTokens.ToString("N0")</td>
                                <td class="text-end">
                                    @(line.EstimatedUsd is { } usd
                                        ? CostEstimator.Format(usd)
                                        : L["Detail_UsageNoPrice"].Value)
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (Costs.TotalUsd(result) is { } total)
                    {
                        <tfoot>
                            <tr class="fw-semibold">
                                <td colspan="4" class="text-end">@L["Detail_UsageTotal"]</td>
                                <td class="text-end">@CostEstimator.Format(total)</td>
                            </tr>
                        </tfoot>
                    }
                </table>

                <p class="small text-secondary mb-0">@L["Detail_UsageNote"]</p>
            </div>
        </div>
    }

    @if (result.ParseErrors.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>@L["Detail_ParseErrorsTitle", result.ParseErrors.Count]</strong>
            @L["Detail_ParseErrorsBody"]
            <ul class="mb-0 mt-2 small">
                @foreach (var parseError in result.ParseErrors.Take(10))
                {
                    <li>@parseError</li>
                }
            </ul>
        </div>
    }

    <ul class="nav nav-tabs mb-3">
        @foreach (var tab in Tabs)
        {
            <li class="nav-item">
                <button class="nav-link @(activeTab == tab ? "active" : "")"
                        @onclick="() => SetTab(tab)">
                    @L[$"Detail_Tab{tab}"]
                </button>
            </li>
        }
    </ul>

    @if (activeTab == TabPlan)
    {
        @if (result.Plan is null)
        {
            <div class="alert alert-secondary">@L["Detail_NoPlan"]</div>
        }
        else
        {
            <p class="lead">@result.Plan.Overview</p>

            @foreach (var phase in result.Plan.Phases.OrderBy(p => p.Order))
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>@L["Detail_Phase", phase.Order, phase.Title]</strong>
                    </div>
                    <div class="card-body">
                        <p class="mb-2"><em>@L["Detail_WhyNow"]</em> @phase.Rationale</p>

                        @if (phase.Objects.Count > 0)
                        {
                            <p class="mb-2">
                                @foreach (var obj in phase.Objects)
                                {
                                    <code class="me-2">@obj</code>
                                }
                            </p>
                        }

                        <p class="mb-0 text-danger-emphasis"><em>@L["Detail_Risk"]</em> @phase.Risk</p>
                    </div>
                </div>
            }

            @if (result.Plan.GlobalRisks.Count > 0)
            {
                <h5>@L["Detail_GlobalRisks"]</h5>
                <ul>
                    @foreach (var risk in result.Plan.GlobalRisks)
                    {
                        <li>@risk</li>
                    }
                </ul>
            }

            <p class="small text-secondary">@L["Detail_PlanGeneratedWith", result.Plan.ModelUsed]</p>
        }
    }
    else if (activeTab == TabObjects)
    {
        @*
            El desplegable se controla con estado de Blazor y no con
            data-bs-toggle. Dos motivos: la plantilla solo carga el CSS de
            Bootstrap, no su JavaScript, así que el atributo no hacía nada; y
            dejar que Bootstrap añada y quite clases sobre un DOM que Blazor
            gestiona es una fuente conocida de desincronización cuando el
            componente se vuelve a renderizar.
        *@
        <div class="accordion">
            @foreach (var obj in Programmable)
            {
                var isOpen = expanded == obj.FullName;

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(isOpen ? "" : "collapsed")" type="button"
                                aria-expanded="@isOpen.ToString().ToLowerInvariant()"
                                @onclick="() => Toggle(obj.FullName)">
                            <span class="badge @BadgeClass(obj.Risk.Level) me-2">@obj.Risk.Value</span>
                            <code class="me-2">@obj.FullName</code>
                            <span class="text-secondary small">@L.Text(obj.Kind)</span>
                        </button>
                    </h2>
                    <div class="accordion-collapse collapse @(isOpen ? "show" : "")">
                        <div class="accordion-body">
                            @if (obj.Documentation is { } doc)
                            {
                                <p>@doc.Summary</p>

                                @if (doc.BusinessRules.Count > 0)
                                {
                                    <h6>@L["Detail_BusinessRules"]</h6>
                                    <ul>
                                        @foreach (var rule in doc.BusinessRules)
                                        {
                                            <li>@rule</li>
                                        }
                                    </ul>
                                }

                                @if (doc.SideEffects.Count > 0)
                                {
                                    <h6>@L["Detail_SideEffects"]</h6>
                                    <ul>
                                        @foreach (var effect in doc.SideEffects)
                                        {
                                            <li>@effect</li>
                                        }
                                    </ul>
                                }

                                <h6>@L["Detail_MigrationTarget"]</h6>
                                <p>@doc.MigrationTarget</p>
                                <p class="small text-secondary">@L["Detail_InterpretedWith", doc.ModelUsed]</p>
                            }
                            else
                            {
                                <p class="text-secondary"><em>@L["Detail_NoDocumentation"]</em></p>
                            }

                            <h6>@L["Detail_VerifiedFacts"]</h6>
                            <p class="small mb-2">
                                @L["Detail_MetricsLine",
                                   obj.Metrics.Lines,
                                   obj.Metrics.StatementCount,
                                   obj.Metrics.ControlFlowComplexity,
                                   obj.Metrics.CursorCount,
                                   obj.Metrics.DynamicSqlCount,
                                   obj.Metrics.TransactionCount,
                                   L.YesNo(obj.Metrics.HasErrorHandling)]
                            </p>

                            @RenderEdges(obj, DependencyKind.Reads, L["Detail_Reads"])
                            @RenderEdges(obj, DependencyKind.Writes, L["Detail_Writes"])
                            @RenderEdges(obj, DependencyKind.Calls, L["Detail_Calls"])

                            @if (obj.Risk.Factors.Count > 0)
                            {
                                <h6 class="mt-3">@L["Detail_RiskBreakdown", obj.Risk.Value]</h6>
                                <ul class="small">
                                    @foreach (var factor in obj.Risk.Factors)
                                    {
                                        <li><strong>+@factor.Points</strong> @factor.Description</li>
                                    }
                                </ul>
                            }

                            <details class="mt-3">
                                <summary class="small">@L["Detail_ShowSource"]</summary>
                                <pre class="mt-2 p-2 bg-body-secondary small"><code>@obj.Body</code></pre>
                            </details>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (activeTab == TabGraph)
    {
        <div class="btn-group mb-3">
            <button class="btn btn-sm @(graphMode == GraphMode.Calls ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SetGraph(GraphMode.Calls)">
                @L["Detail_GraphCalls"]
            </button>
            <button class="btn btn-sm @(graphMode == GraphMode.Data ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => SetGraph(GraphMode.Data)">
                @L["Detail_GraphData"]
            </button>
        </div>

        <div class="card">
            <div class="card-body overflow-auto">
                <div id="mermaid-host"></div>
            </div>
        </div>

        <p class="small text-secondary mt-2">@L["Detail_GraphNote"]</p>
    }
}

@code {
    private enum GraphMode { Calls, Data }

    // Las pestañas se identifican por una clave estable, no por su rótulo: si el
    // rótulo se traduce, comparar cadenas visibles rompería la navegación.
    private const string TabPlan = "Plan";
    private const string TabObjects = "Objects";
    private const string TabGraph = "Graph";

    private static readonly string[] Tabs = [TabPlan, TabObjects, TabGraph];

    [Parameter] public Guid Id { get; set; }

    private AnalysisResult? result;
    private bool loading = true;
    private string activeTab = TabPlan;
    private GraphMode graphMode = GraphMode.Calls;
    private bool graphNeedsRender;

    /// <summary>Nombre completo del objeto desplegado, o nulo si están todos cerrados.</summary>
    private string? expanded;

    /// <summary>
    /// Un solo objeto abierto a la vez, que es lo que hacía el data-bs-parent del
    /// acordeón de Bootstrap. Volver a pulsar el que ya está abierto lo cierra.
    /// </summary>
    private void Toggle(string fullName) =>
        expanded = expanded == fullName ? null : fullName;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private IEnumerable<SqlObject> Programmable =>
        result!.Objects.Where(o => o.IsProgrammable).OrderByDescending(o => o.Risk.Value);

    protected override async Task OnInitializedAsync()
    {
        string? userId = null;

        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        }

        result = await Sender.Send(new GetAnalysisQuery(Id, userId ?? string.Empty));
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!graphNeedsRender || result is null) return;

        graphNeedsRender = false;

        var definition = graphMode == GraphMode.Calls
            ? MermaidGraphBuilder.BuildCallGraph(result)
            : MermaidGraphBuilder.BuildDataGraph(result);

        await JS.InvokeVoidAsync("legacyLens.renderMermaid", "mermaid-host", definition);
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
        if (tab == TabGraph) graphNeedsRender = true;
    }

    private void SetGraph(GraphMode mode)
    {
        graphMode = mode;
        graphNeedsRender = true;
    }

    private IEnumerable<(string Label, string Value)> SummaryTiles()
    {
        var programmable = result!.Objects.Where(o => o.IsProgrammable).ToList();
        var risky = programmable.Count(o => o.Risk.Level is RiskLevel.High or RiskLevel.Critical);

        yield return (L["Detail_TileObjects"], result.ObjectCount.ToString());
        yield return (L["Detail_TileProgrammable"], programmable.Count.ToString());
        yield return (L["Detail_TileDependencies"], result.Dependencies.Count.ToString());
        yield return (L["Detail_TileRisky"], L["Detail_OfTotal", risky, programmable.Count]);
    }

    private RenderFragment RenderEdges(SqlObject obj, DependencyKind kind, string label) => builder =>
    {
        var targets = result!.Dependencies
            .Where(d => d.From == obj.FullName && d.Kind == kind)
            .Select(d => d.To)
            .ToList();

        if (targets.Count == 0) return;

        builder.AddMarkupContent(0,
            $"<p class=\"small mb-1\"><strong>{label}</strong> " +
            string.Join(", ", targets.Select(t => $"<code>{t}</code>")) +
            "</p>");
    };

    private static string BadgeClass(RiskLevel level) => level switch
    {
        RiskLevel.Low => "text-bg-success",
        RiskLevel.Medium => "text-bg-warning",
        RiskLevel.High => "text-bg-danger",
        _ => "text-bg-dark"
    };
}
