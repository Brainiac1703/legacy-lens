# Copia este fichero a .env y ajusta los valores.
# .env está excluido del repositorio.

# --- SQL Server de desarrollo ---------------------------------------------
# Obligatoria. SQL Server exige al menos 8 caracteres con mayúsculas,
# minúsculas, dígitos y símbolos, o el contenedor no arranca.
MSSQL_SA_PASSWORD=Desarrollo.2026!

# --- Azure OpenAI ---------------------------------------------------------
# Opcional. Sin endpoint la aplicación arranca y entrega el análisis estático
# completo, avisando en pantalla de que no hay IA configurada.
#
#   cd Deploy/infra && terraform output -raw openai_endpoint
Ai__Endpoint=

# Opcional y solo para desarrollo. Dejándola vacía se usa la identidad de tu
# sesión de az login, que es como funciona en producción. Dentro de un
# contenedor esa sesión no está disponible, así que aquí sí suele hacer falta:
#
#   az cognitiveservices account keys list -n oai-legacylens-tfm \
#     -g rg-legacylens-tfm --query key1 -o tsv
Ai__ApiKey=

# --- Puertos --------------------------------------------------------------
# SQL Server no usa 1433 por omisión para no chocar con una instancia local ni
# con el contenedor de otro proyecto que ya lo tenga cogido.
WEB_PORT=8081
SQLSERVER_PORT=14330
